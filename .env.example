# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GODMODE_OWNER_PASSCODE: Optional server-side owner passcode for Sana Özel (MORPH // GOD MODE).
# When unset in preview, a one-time first-run owner claim form hashes your chosen passcode on the server.
GODMODE_OWNER_PASSCODE=

# GODMODE_OWNER_EMAIL: Optional explicit owner identity email required during owner claim & verification.
GODMODE_OWNER_EMAIL=

# GODMODE_BOOTSTRAP_TOKEN: Optional setup token required to perform initial first-run owner claim.
GODMODE_BOOTSTRAP_TOKEN=

# GODMODE_STORE_PATH: Optional durable JSON file path for owner credentials, keys, devices, sessions, and audit logs.
# Defaults to .morph-data/godmode-store.json. On ephemeral containers (e.g., Cloud Run), mount a persistent volume here.
GODMODE_STORE_PATH=
